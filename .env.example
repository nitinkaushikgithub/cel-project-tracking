# Copy to .env and fill in before running `docker compose up`.
# .env is read by both Docker Compose (for the values below) and, outside
# Docker, by the Prisma CLI via DATABASE_URL.

POSTGRES_USER=cel_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cel_project_tracking

# Only needed when running Prisma commands (e.g. `npx prisma migrate dev`)
# from the host rather than inside the app container. Point it at
# localhost if you temporarily publish the postgres port for that purpose;
# the compose file itself builds this value from the POSTGRES_* vars above.
DATABASE_URL=postgresql://cel_app:change-me@localhost:5432/cel_project_tracking
