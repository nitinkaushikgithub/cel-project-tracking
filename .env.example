# Copy to .env and fill in before running `docker compose up`.
# .env is read by both Docker Compose (for the values below) and, outside
# Docker, by the Prisma CLI via DATABASE_URL.

POSTGRES_USER=cel_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cel_project_tracking

# Only needed when running Prisma commands (e.g. `npx prisma migrate dev`)
# from the host rather than inside the app container. Point it at
# localhost if you temporarily publish the postgres port for that purpose;
# the compose file itself builds this value from the POSTGRES_* vars above.
DATABASE_URL=postgresql://cel_app:change-me@localhost:5432/cel_project_tracking

# Auth.js v5 session/JWT signing key — required, the app won't start in
# production without it. Generate a real one with `openssl rand -base64 32`
# (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Never reuse this example value.
AUTH_SECRET=change-me-generate-a-real-32-byte-secret

# Lets Auth.js v5 accept requests behind Caddy's reverse proxy on whatever
# internal hostname CEL ends up using (CLAUDE.md §9.10 — not decided yet).
AUTH_TRUST_HOST=true

# Optional. Leave both unset for a normal first run — the seed script then
# generates a random admin password and prints it once to the app
# container's logs on first creation (`docker compose logs app`). Set
# SEED_ADMIN_PASSWORD here instead only if you specifically need a known
# password (e.g. scripted/CI setups) — never commit a real value if you do.
SEED_ADMIN_LOGIN_NAME=admin
SEED_ADMIN_PASSWORD=

# --- Email alerts (Phase 3) ---
# CEL's own SMTP server — CLAUDE.md §2/§8.2: "SMTP server details and
# credentials, with outbound access confirmed through the firewall.
# Without this the email alerts cannot be sent." If SMTP_HOST is left
# unset, the app runs fine and Alert rows still get created — it just logs
# instead of sending (see src/lib/email.ts) rather than failing.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (typically port 465); leave "false" for STARTTLS
# (typically port 587), which is far more common for corporate SMTP.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# What alert emails show as their sender.
SMTP_FROM=cel-project-monitoring@cel.example

# Used only to build the "open this activity" link inside alert emails
# (CLAUDE.md hard constraint #2: that link only works on the CEL network,
# so it's a convenience, not the source of truth — the email body always
# carries full activity detail regardless). Leave unset to omit the link
# entirely rather than emit a broken one. No trailing slash.
APP_BASE_URL=
